# ============================================================
# Dokan v2 — Environment Variables Reference (no secrets)
# انسخ إلى .env.local واملأ القيم (القيم الحساسة لا تُرفع أبدًا)
# التطبيق: Vercel (Production) + .env.local (محلي)
# ============================================================

# --- Supabase ---
# URL مشروع Supabase (https://<ref>.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=
# anon key العامة (آمنة للكشف — محمية بـ RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# service_role key — SERVER ONLY (لا تُكشف أبدًا للعميل)
SUPABASE_SERVICE_ROLE_KEY=

# --- Web Push (VAPID) — الإشعارات ---
# المفاتيح العامة/الخاصة (توليد: npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# بريد للتواصل مع مزود الـ push (اختياري — fallback mailto:admin@dokanstore.xyz)
VAPID_CONTACT=mailto:admin@dokanstore.xyz

# --- Telegram — إشعارات الطلبات ---
# توكن البوت من @BotFather
TELEGRAM_BOT_TOKEN=
# اسم مستخدم البوت (بدون @) — للربط
TELEGRAM_BOT_USERNAME=
# سر توقيع الـ webhook (اختياري — تأكيد أن الطلبات من تيليجرام فعلًا)
TELEGRAM_WEBHOOK_SECRET=

# --- الموقع العام (OG/meta) ---
NEXT_PUBLIC_SITE_URL=https://www.dokanstore.xyz

# --- Cache (اختياري — LOCAL افتراضيًا) ---
# غير مطلوب إلا لتفعيل Upstash (غير موصول بعد):
# CACHE_PROVIDER=local | upstash
# KV_URL=rediss://...

# --- Sentry (اختياري) ---
# SENTRY_DSN=
# SENTRY_AUTH_TOKEN=
